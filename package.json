{
  "name": "underleaf",
  "productName": "Underleaf",
  "version": "0.1.0",
  "description": "A local, offline LaTeX editor with an Overleaf-style workflow.",
  "author": "Heyuan Huang",
  "license": "Apache-2.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/collect-licenses.mjs",
    "dev": "npm run assets && electron-vite dev",
    "build": "npm run assets && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "fetch:tectonic": "node scripts/fetch-tectonic.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && node scripts/fetch-tectonic.mjs --platform win32 --arch x64 && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && node scripts/fetch-tectonic.mjs --platform darwin --arch x64,arm64 && electron-builder --mac --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@lezer/highlight": "^1.0.0",
    "@mdi/js": "^7.4.47",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zustand": "^5.1.0"
  }
}
