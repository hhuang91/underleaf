# Default latexmk configuration used by Underleaf.
#
# It is loaded as the "system" rc file, so a latexmkrc inside a project still
# takes precedence. The rules below cover the same extras that Overleaf's
# compile servers provide out of the box.

# "LaTeX" compiler: latex -> dvi -> pdf without needing Ghostscript.
$dvipdf = 'dvipdfmx %O -o %D %S';

# Glossaries (glossaries / glossaries-extra packages).
add_cus_dep('glo', 'gls', 0, 'underleaf_makeglossaries');
add_cus_dep('acn', 'acr', 0, 'underleaf_makeglossaries');
sub underleaf_makeglossaries {
    my ($base_name, $path) = fileparse($_[0]);
    return system('makeglossaries', '-q', '-d', $path, $base_name);
}

# Nomenclature (nomencl package).
add_cus_dep('nlo', 'nls', 0, 'underleaf_nomencl');
sub underleaf_nomencl {
    return system('makeindex', '-s', 'nomencl.ist', '-o', "$_[0].nls", "$_[0].nlo");
}

push @generated_exts, 'glo', 'gls', 'glg', 'acn', 'acr', 'alg', 'nlo', 'nls', 'nlg';

1;
